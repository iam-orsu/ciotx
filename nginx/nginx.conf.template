# nginx.conf.template
# DOMAIN_NAME is injected by envsubst at container startup from .env
# This makes the config fully dynamic — change DOMAIN_NAME in .env and redeploy

# ── HTTP → HTTPS redirect ─────────────────────────────────────────────
server {
    listen 80;
    server_name ${DOMAIN_NAME};

    # ACME challenge for Let's Encrypt SSL cert renewal
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS API Server ──────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    server_name ${DOMAIN_NAME};

    # ── TLS Certificates (managed by certbot) ──────────────────────
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    # ── TLS Hardening ───────────────────────────────────────────────
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # ── Security Headers ────────────────────────────────────────────
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Permitted-Cross-Domain-Policies none always;

    # ── Fingerprinting Removal ──────────────────────────────────────
    server_tokens off;
    proxy_hide_header X-Powered-By;
    proxy_hide_header Server;

    # ── DNS Resolver (Docker internal — resolves 'api' container name)
    resolver 127.0.0.11 valid=10s ipv6=off;

    # ── Request Size Limit ──────────────────────────────────────────
    # Large codebases produce large chunk payloads. Set a generous limit.
    # 64MB allows scanning very large monorepos without 413 errors.
    client_max_body_size 64m;
    client_body_timeout 30s;

    # ── Connection Keepalive ────────────────────────────────────────
    keepalive_timeout 75s;
    keepalive_requests 100;

    # ── Gzip Compression ────────────────────────────────────────────
    # Compresses JSON responses before sending to CLI — reduces bandwidth
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_types application/json text/plain;
    gzip_min_length 512;

    limit_req_status 429;

    # ── API Proxy (/v1/) ────────────────────────────────────────────
    # Strict rate limit here: one long-running scan = one long HTTP request.
    location /v1/ {
        limit_req zone=api burst=10 nodelay;

        proxy_pass         http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        # Long timeout — deep code analysis takes minutes, not seconds
        proxy_read_timeout    35m;
        proxy_send_timeout    35m;
        proxy_connect_timeout 10s;

        # Buffer large request bodies before sending to Go server
        proxy_request_buffering on;
        proxy_buffering         off;  # Stream responses back immediately
    }

    # ── Admin Web Panel ─────────────────────────────────────────────
    # Relaxed rate limit: dashboard refreshes every 60s across ~3 endpoints.
    # Auth is enforced in the Go handler (HMAC session cookie).
    location /admin {
        limit_req zone=api_admin burst=30 nodelay;

        proxy_pass         http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";

        proxy_read_timeout    30s;
        proxy_send_timeout    30s;
        proxy_connect_timeout 10s;
    }

    # ── Health Check (nginx → api, no rate limit, no logging) ──────
    location = /health {
        proxy_pass         http://api:8080/health;
        proxy_http_version 1.1;
        proxy_read_timeout 5s;
        access_log         off;
    }

    # ── Install Script (served statically) ─────────────────────────
    location = /install.sh {
        root /var/www/static;
        add_header Content-Type  "text/plain; charset=utf-8";
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma        "no-cache";
    }

    # ── CLI Binary Downloads (/releases/ciotx-linux-amd64 etc.) ────
    location /releases/ {
        root /var/www/static;
        autoindex off;
        add_header Content-Type        "application/octet-stream";
        add_header Content-Disposition "attachment";
        add_header Cache-Control       "public, max-age=3600";
    }

    # ── Block common scanner/probe paths ───────────────────────────
    location ~ ^/(wp-admin|\.env|\.git|phpinfo) {
        return 404;
    }
}
