# nginx.conf.template
# DOMAIN_NAME is injected by envsubst at container startup from .env
# This makes the config fully dynamic — change DOMAIN_NAME in .env and rebuild

server {
    listen 80;
    server_name ${DOMAIN_NAME};

    # ACME challenge for Let's Encrypt SSL cert renewal
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all HTTP to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN_NAME};

    # TLS certificates managed by certbot
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;

    # Modern TLS only — TLS 1.2+ with strong ciphers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Security headers — prevent fingerprinting
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    # Remove server version from response headers
    server_tokens off;

    # DNS resolver for Docker internal network (resolves 'api' container name)
    resolver 127.0.0.11 valid=10s;

    # Strip any headers that might reveal backend technology
    proxy_hide_header X-Powered-By;
    proxy_hide_header Server;

    # Rate limiting — prevent abuse
    limit_req zone=api burst=20 nodelay;

    # Proxy all API traffic to the ciotx server container
    location /v1/ {
        proxy_pass         http://api:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # Long timeout for scan requests (deep analysis takes time)
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_connect_timeout 10s;
    }

    # Health check endpoint
    location /health {
        proxy_pass http://api:8080/health;
        proxy_http_version 1.1;
        access_log off;
    }

    # install.sh served directly by nginx
    location /install.sh {
        root /var/www/static;
        add_header Content-Type text/plain;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}
