# ================================================================
# ciotx — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# ================================================================

# ── Domain & Server ─────────────────────────────────────────────
# Your domain name (e.g. api.ciotx.ai or a temp domain for testing)
DOMAIN_NAME=api.ciotx.ai

# Your VPS public IP (used for DNS setup reference)
VPS_SERVER_IP=1.2.3.4

# Email for Let's Encrypt SSL certificate registration & renewal alerts
SSL_EMAIL=you@youremail.com

# ── LLM Provider (INTERNAL — never exposed to users) ────────────
# This key is ONLY used inside the Docker container on your server.
# Users never see this. Their traffic only ever reaches your domain.
LLM_API_KEY=sk-your-deepseek-api-key-here

# ── Authentication ───────────────────────────────────────────────
# Master license key — operator bypass for testing and emergency access.
# Phase 2: DB-issued keys are the primary auth path; this is a fallback.
MASTER_LICENSE_KEY=ciotx_dev_testkey_change_this_in_prod

# ── Database (Phase 2) ───────────────────────────────────────────
# Strong random password for the PostgreSQL ciotx user.
# Generate one: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-strong-random-password

# ── GitHub PR Integration (Phase 6) ─────────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new and fill these in.
# Leave all four vars unset/empty to disable the GitHub integration entirely.
#
# GitHub App ID (found on the App's settings page)
GITHUB_APP_ID=
#
# Private key from the GitHub App — base64-encode the downloaded .pem file:
#   base64 -w 0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY_BASE64=
#
# Webhook secret — set this in your GitHub App's webhook settings too.
# Generate: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
#
# Webhook URL to configure in the GitHub App:
#   https://${DOMAIN_NAME}/webhooks/github
# Events to subscribe: push, installation

# ── Admin Web Panel (Phase 4) ────────────────────────────────────
# Password for the /admin operator control panel.
# Leave unset to disable the admin panel entirely.
# Generate: openssl rand -base64 24
ADMIN_PASSWORD=change-me-strong-admin-password

# ── Server ───────────────────────────────────────────────────────
PORT=8080
