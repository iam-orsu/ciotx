# ================================================================
# ciotx — Environment Configuration
# Copy this file to .env and fill in every value.
#
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env to git (it is already in .gitignore).
# See DEPLOY.md for step-by-step instructions.
# ================================================================

# ── Domain & Server ─────────────────────────────────────────────
# Your domain name — this gets baked into every CLI binary as the API endpoint.
# The A record for this domain must point to VPS_SERVER_IP before you deploy.
DOMAIN_NAME=api.yourdomain.com

# Your VPS public IP — used to verify DNS during deploy.
VPS_SERVER_IP=1.2.3.4

# Email for Let's Encrypt SSL certificate registration and renewal alerts.
SSL_EMAIL=you@youremail.com

# ── AI Analysis (INTERNAL — never exposed to users) ─────────────
# DeepSeek API key. Get one at https://platform.deepseek.com
# This key lives only inside the Docker container.
# Your users only ever talk to your domain — they never see this.
LLM_API_KEY=sk-your-deepseek-api-key-here

# ── Authentication ───────────────────────────────────────────────
# Master license key — your personal operator bypass key.
# Generate: openssl rand -hex 32 — then prefix with ciotx_
MASTER_LICENSE_KEY=ciotx_change_this_to_a_strong_random_value

# ── Database ─────────────────────────────────────────────────────
# Strong random password for the PostgreSQL ciotx user.
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=change-me-strong-random-password

# ── GitHub App Integration (REQUIRED) ───────────────────────────
# ciotx uses a GitHub App to scan repos on every push and open fix PRs.
# Create your App at https://github.com/settings/apps/new
# Full instructions in DEPLOY.md — "Thing 2: GitHub App"
#
# GitHub App ID — shown on the App settings page after creation.
GITHUB_APP_ID=your-app-id-number-here
#
# Base64-encoded private key — download the .pem from the App settings,
# then run: base64 -w 0 your-app.private-key.pem
GITHUB_APP_PRIVATE_KEY_BASE64=your-base64-encoded-private-key-here
#
# Webhook secret — the value you generated with 'openssl rand -hex 32'
# and entered into the GitHub App's Webhook Secret field.
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
#
# Set this as the Webhook URL in your GitHub App:
#   https://DOMAIN_NAME/webhooks/github
# Subscribe to events: push, installation

# ── Admin Web Panel ──────────────────────────────────────────────
# Password for the /admin operator dashboard.
# Generate: openssl rand -base64 24
# Leave empty to disable the admin panel entirely.
ADMIN_PASSWORD=change-me-strong-admin-password

# ── Server ───────────────────────────────────────────────────────
PORT=8080
